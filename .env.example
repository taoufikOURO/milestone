# Copier en .env (jamais versionné) et compléter. Aucune vraie valeur ici.

# ─── Développement local ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://[username]:[password]@localhost:5432/milestone"
# Base dédiée aux tests d'intégration et end-to-end (nom terminé par _test, vidée par les tests)
TEST_DATABASE_URL="postgresql://[username]:[password]@localhost:5432/milestone_test"

# ─── Environnement ───────────────────────────────────────────────────────────
# « production » : emails envoyés par SMTP (Gmail). Toute autre valeur, ou vide :
# « development », emails affichés dans la console du serveur (rien n'est envoyé).
# Les tests forcent toujours la console, quelle que soit cette valeur.
ENVIRONMENT="development"

# ─── Emails (SMTP, utilisé seulement si ENVIRONMENT=production) ──────────────
# Serveur SMTP (Gmail : smtp.gmail.com)
SMTP_HOST=""
# Port SMTP : 587 en STARTTLS (valeur par défaut si vide), 465 en TLS direct
SMTP_PORT="587"
# Adresse Gmail complète du compte d'envoi
SMTP_USER=""
# Mot de passe d'application Gmail (16 caractères), jamais le mot de passe du compte
SMTP_PASSWORD=""
# Expéditeur : même adresse que SMTP_USER, nom affiché facultatif
MAIL_FROM="Milestone <adresse@gmail.com>"
# Tests e2e uniquement : fichier où le transport console recopie les emails (ne pas définir en production)
EMAIL_OUTBOX_FILE=""

# ─── Production (variables de l'hébergeur, voir docs/deploiement.md) ─────────
# Connexion poolée Supabase (Supavisor, mode transaction), utilisée par l'application
# DATABASE_URL="postgresql://[user]:[password]@[pooler-host]:6543/postgres"
# Connexion directe, utilisée uniquement par `prisma migrate deploy`
DIRECT_URL=""
# Générer avec : npx auth secret
AUTH_SECRET=""
# URL publique, utilisée dans les liens des emails (obligatoire en production)
APP_URL="http://localhost:3000"
# Fuseau qui définit « aujourd'hui » pour la planification (Africa/Lome si vide)
PLANNING_TIMEZONE="Africa/Lome"
